PORT=3000
HOST=127.0.0.1

# Strongly recommended whenever the service is reachable over a network.
# MCP callers send this value as: Authorization: Bearer <value>
MCP_SERVER_API_KEY=replace-with-a-long-random-value

# Optional deployment-wide defaults. Per-request X-EC-* headers override them.
EC_BASE_URL=https://api.emarsys.net/api
# Optional: copy the Token Endpoint shown for the OIDC API credential.
EC_TOKEN_URL=https://auth.emarsys.net/oauth2/token

# Only enable plain HTTP for a local mock server. Keep false in production.
ALLOW_INSECURE_EC_URLS=false
